<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cookie Haus | Freshly Baked</title>
    
    <!-- GOOGLE FONTS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --brown: #4A2E2B;
            --light-brown: #6F4E37;
            --beige: #F5EBE6;
            --dark-beige: #E6D7CC;
            --white: #FFFFFF;
            --whatsapp-green: #25D366;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: var(--beige);
            background-image: radial-gradient(#E6D7CC 0.75px, transparent 0.75px);
            background-size: 16px 16px;
            color: var(--brown);
            line-height: 1.6;
            padding-top: 80px;
        }

        h1, h2, h3, .nav-brand, .cart-title {
            font-family: 'Playfair Display', serif;
        }

        /* NAVIGATION BAR */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background-color: var(--brown);
            color: var(--beige);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 5%;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            z-index: 1000;
        }

        .nav-brand {
            font-size: 1.5rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .nav-cart-badge {
            background-color: var(--light-brown);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
            border: 1px solid rgba(255,255,255,0.1);
            white-space: nowrap;
        }

        /* HEADER / HERO */
        header {
            text-align: center;
            padding: 3rem 1rem 2rem 1rem;
            background: linear-gradient(to bottom, var(--white), var(--beige));
            border-bottom: 2px dashed var(--dark-beige);
        }

        header h1 {
            font-size: 2.5rem;
            color: var(--brown);
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        header p {
            font-style: italic;
            margin-top: 0.4rem;
            font-size: 1.1rem;
            color: var(--light-brown);
        }

        /* CONTAINER */
        .container {
            width: 100%;
            max-width: 1000px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        .section-title {
            text-align: center;
            margin: 2.5rem 0 1.2rem 0;
            font-size: 1.8rem;
            color: var(--brown);
            position: relative;
        }

        .section-title::after {
            content: '';
            display: block;
            width: 60px;
            height: 2px;
            background-color: var(--light-brown);
            margin: 6px auto 0 auto;
        }

        /* MENU GRID */
        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .menu-card {
            background: var(--white);
            border-radius: 10px;
            padding: 1.5rem;
            box-shadow: 0 6px 12px rgba(74,46,43,0.06);
            border: 1px solid var(--dark-beige);
        }

        .menu-card h3 {
            font-size: 1.2rem;
            color: var(--brown);
            margin-bottom: 1rem;
            border-bottom: 1px solid var(--beige);
            padding-bottom: 0.5rem;
        }

        .menu-list {
            list-style: none;
        }

        .menu-list li {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.5rem 0;
            font-size: 0.95rem;
            border-bottom: 1px dashed var(--beige);
        }

        .menu-list li:last-child {
            border-bottom: none;
        }

        .item-price {
            font-weight: 600;
            color: var(--light-brown);
        }

        /* ORDER LAYOUT */
        .order-layout {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        @media (min-width: 768px) {
            .order-layout {
                display: grid;
                grid-template-columns: 1.6fr 1fr;
                align-items: start;
            }
        }

        form, .cart-box {
            background: var(--white);
            padding: 1.5rem;
            border-radius: 10px;
            box-shadow: 0 6px 12px rgba(74,46,43,0.06);
            border: 1px solid var(--dark-beige);
        }

        .form-group {
            margin-bottom: 1.2rem;
        }

        label {
            display: block;
            margin-bottom: 0.4rem;
            font-weight: 600;
            font-size: 0.95rem;
        }

        input, select, textarea {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid var(--dark-beige);
            border-radius: 6px;
            background-color: var(--beige);
            color: var(--brown);
            font-size: 1rem;
            font-family: 'Poppins', sans-serif;
        }

        input:focus, select:focus, textarea:focus {
            outline: 2px solid var(--brown);
        }

        .checkbox-group {
            display: grid;
            grid-template-columns: 1fr;
            gap: 0.5rem;
            margin-top: 0.4rem;
        }

        @media (min-width: 450px) {
            .checkbox-group {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .checkbox-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--beige);
            padding: 0.6rem;
            border-radius: 6px;
            font-size: 0.9rem;
        }

        .checkbox-item input {
            width: auto;
            accent-color: var(--brown);
        }

        /* CART BOX - STICKY & RESPONSIVE */
        .cart-box {
            position: static;
        }

        @media (min-width: 768px) {
            .cart-box {
                position: sticky;
                top: 95px;
            }
        }

        .cart-title {
            font-size: 1.3rem;
            border-bottom: 2px solid var(--dark-beige);
            padding-bottom: 0.5rem;
            margin-bottom: 1rem;
            color: var(--brown);
        }

        .cart-item {
            display: flex;
            justify-content: space-between;
            font-size: 0.95rem;
            margin-bottom: 0.6rem;
        }

        .cart-total {
            margin-top: 1rem;
            padding-top: 0.8rem;
            border-top: 2px solid var(--brown);
            font-size: 1.15rem;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            color: var(--brown);
        }

        button {
            background-color: var(--whatsapp-green);
            color: var(--white);
            border: none;
            padding: 0.9rem 1.5rem;
            font-size: 1rem;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            width: 100%;
            transition: opacity 0.3s;
            margin-top: 1.5rem;
            font-family: 'Poppins', sans-serif;
        }

        button:hover {
            opacity: 0.9;
        }

        /* FOOTER */
        footer {
            text-align: center;
            padding: 2.5rem 1rem;
            background-color: var(--brown);
            color: var(--beige);
            margin-top: 3rem;
            font-size: 0.9rem;
        }

        footer p {
            margin: 0.3rem 0;
        }
    </style>
</head>
<body>

    <!-- NAVIGATION BAR -->
    <nav>
        <div class="nav-brand">Cookie Haus</div>
        <div class="nav-cart-badge">
            Cart: <span id="navCount">0</span> items (<span id="navTotal">GHS 0</span>)
        </div>
    </nav>

    <!-- HEADER / HERO -->
    <header>
        <h1>Cookie Haus</h1>
        <p>Freshly baked artisanal treats crafted with love ✨</p>
    </header>

    <div class="container">
        
        <!-- MENU DISPLAY -->
        <h2 class="section-title">Menu & Price Guide</h2>
        <div class="menu-grid">
            
            <div class="menu-card">
                <h3>Signature Flavors</h3>
                <ul class="menu-list">
                    <li><span>Nutella Bliss</span> <span class="item-price">Core-filled</span></li>
                    <li><span>Biscoff Crunch</span> <span class="item-price">Cookie Butter</span></li>
                    <li><span>Cookies & Crème</span> <span class="item-price">Oreo Loaded</span></li>
                    <li><span>Chocolate Chip</span> <span class="item-price">Classic Chunk</span></li>
                </ul>
            </div>

            <div class="menu-card">
                <h3>Sets & Mini Options</h3>
                <ul class="menu-list">
                    <li><span>Set of 2 Cookies</span> <span class="item-price">GHS 50</span></li>
                    <li><span>Set of 6 Cookies</span> <span class="item-price">GHS 110</span></li>
                    <li><span>Set of 9 Cookies</span> <span class="item-price">GHS 160</span></li>
                    <li><span>12 Mini Cookies</span> <span class="item-price">GHS 70</span></li>
                    <li><span>24 Mini Cookies</span> <span class="item-price">GHS 130</span></li>
                    <li><span>34 Mini Cookies</span> <span class="item-price">GHS 180</span></li>
                </ul>
            </div>

            <div class="menu-card">
                <h3>Sweet Drizzles</h3>
                <ul class="menu-list">
                    <li><span>Chocolate Drizzle</span> <span class="item-price">GHS 10</span></li>
                    <li><span>Biscoff Drizzle</span> <span class="item-price">GHS 10</span></li>
                    <li><span>Caramel Drizzle</span> <span class="item-price">GHS 10</span></li>
                </ul>
            </div>

        </div>

        <!-- ORDER FORM & CART SECTION -->
        <h2 class="section-title">Place Your Order</h2>
        <div class="order-layout">
            
            <form id="orderForm" onsubmit="handleOrder(event)" onchange="updateCart()">
                
                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" required placeholder="Enter your full name">
                </div>

                <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input type="tel" id="phone" required placeholder="Enter your phone number">
                </div>

                <div class="form-group">
                    <label for="setCategory">Select Cookie Category & Size</label>
                    <select id="setCategory" required onchange="updateCart()">
                        <option value="" data-price="0">-- Choose an option --</option>
                        <optgroup label="Cookie Sets">
                            <option value="Set of 2 cookies" data-price="50">Set of 2 cookies - GHS 50</option>
                            <option value="Set of 6 cookies" data-price="110">Set of 6 cookies - GHS 110</option>
                            <option value="Set of 9 cookies" data-price="160">Set of 9 cookies - GHS 160</option>
                        </optgroup>
                        <optgroup label="Mini Cookies (Bite-sized)">
                            <option value="12 mini cookies" data-price="70">12 mini cookies - GHS 70</option>
                            <option value="24 mini cookies" data-price="130">24 mini cookies - GHS 130</option>
                            <option value="34 mini cookies" data-price="180">34 mini cookies - GHS 180</option>
                        </optgroup>
                    </select>
                </div>

                <div class="form-group">
                    <label>Choose Your Flavors</label>
                    <div class="checkbox-group">
                        <div class="checkbox-item">
                            <input type="checkbox" id="flavor1" name="flavor" value="Nutella Bliss">
                            <label for="flavor1">Nutella Bliss</label>
                        </div>
                        <div class="checkbox-item">
                            <input type="checkbox" id="flavor2" name="flavor" value="Biscoff Crunch">
                            <label for="flavor2">Biscoff Crunch</label>
                        </div>
                        <div class="checkbox-item">
                            <input type="checkbox" id="flavor3" name="flavor" value="Cookies & Crème">
                            <label for="flavor3">Cookies & Crème</label>
                        </div>
                        <div class="checkbox-item">
                            <input type="checkbox" id="flavor4" name="flavor" value="Chocolate Chip">
                            <label for="flavor4">Chocolate Chip</label>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Add Drizzles (+ GHS 10 each)</label>
                    <div class="checkbox-group">
                        <div class="checkbox-item">
                            <input type="checkbox" id="drizzle1" name="drizzle" value="Chocolate Drizzle" data-price="10" onchange="updateCart()">
                            <label for="drizzle1">Chocolate Drizzle</label>
                        </div>
                        <div class="checkbox-item">
                            <input type="checkbox" id="drizzle2" name="drizzle" value="Biscoff Drizzle" data-price="10" onchange="updateCart()">
                            <label for="drizzle2">Biscoff Drizzle</label>
                        </div>
                        <div class="checkbox-item">
                            <input type="checkbox" id="drizzle3" name="drizzle" value="Caramel Drizzle" data-price="10" onchange="updateCart()">
                            <label for="drizzle3">Caramel Drizzle</label>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="notes">Special Instructions / Flavor Ratios</label>
                    <textarea id="notes" rows="3" placeholder="e.g., 3 Nutella Bliss and 3 Biscoff Crunch"></textarea>
                </div>

                <button type="submit">Order via WhatsApp</button>
            </form>

            <!-- LIVE CART SUMMARY -->
            <div class="cart-box">
                <h3 class="cart-title">Your Cart</h3>
                <div id="cartItems">
                    <div class="cart-item"><span>No selection yet</span><span>GHS 0</span></div>
                </div>
                <div class="cart-total">
                    <span>Total:</span>
                    <span id="cartTotal">GHS 0</span>
                </div>
            </div>

        </div>
    </div>

    <footer>
        <p><strong>COOKIE HAUS</strong></p>
        <p>WhatsApp: 0537440435</p>
        <p>Snapchat: woah.hickmah</p>
    </footer>

    <script>
        function updateCart() {
            const select = document.getElementById('setCategory');
            const selectedOption = select.options[select.selectedIndex];
            const setPrice = parseFloat(selectedOption.getAttribute('data-price')) || 0;
            const setName = selectedOption.value;

            const cartItemsDiv = document.getElementById('cartItems');
            cartItemsDiv.innerHTML = '';

            let total = 0;
            let count = 0;

            if (setPrice > 0) {
                total += setPrice;
                count += 1;
                cartItemsDiv.innerHTML += `
                    <div class="cart-item">
                        <span>${setName}</span>
                        <span>GHS ${setPrice}</span>
                    </div>
                `;
            } else {
                cartItemsDiv.innerHTML += `
                    <div class="cart-item">
                        <span>No selection yet</span>
                        <span>GHS 0</span>
                    </div>
                `;
            }

            const checkedDrizzles = document.querySelectorAll('input[name="drizzle"]:checked');
            checkedDrizzles.forEach(drizzle => {
                const drizzlePrice = parseFloat(drizzle.getAttribute('data-price')) || 10;
                total += drizzlePrice;
                count += 1;
                cartItemsDiv.innerHTML += `
                    <div class="cart-item">
                        <span>+ ${drizzle.value}</span>
                        <span>GHS ${drizzlePrice}</span>
                    </div>
                `;
            });

            document.getElementById('cartTotal').textContent = `GHS ${total}`;
            document.getElementById('navTotal').textContent = `GHS ${total}`;
            document.getElementById('navCount').textContent = count;
        }

        function handleOrder(event) {
            event.preventDefault();

            const name = document.getElementById('name').value;
            const phone = document.getElementById('phone').value;
            const setSelect = document.getElementById('setCategory');
            const setCategory = setSelect.value;
            const notes = document.getElementById('notes').value;

            const flavors = Array.from(document.querySelectorAll('input[name="flavor"]:checked'))
                                 .map(cb => cb.value);

            const drizzles = Array.from(document.querySelectorAll('input[name="drizzle"]:checked'))
                                    .map(cb => cb.value);

            if (!setCategory) {
                alert('Please choose a cookie set or mini cookies option!');
                return;
            }

            if (flavors.length === 0) {
                alert('Please select at least one flavor!');
                return;
            }

            const total = document.getElementById('cartTotal').textContent;

            let message = `*NEW ORDER - COOKIE HAUS*\n\n`;
            message += `*Name:* ${name}\n`;
            message += `*Phone:* ${phone}\n`;
            message += `*Selection:* ${setCategory}\n`;
            message += `*Flavors:* ${flavors.join(', ')}\n`;
            message += `*Drizzles:* ${drizzles.length > 0 ? drizzles.join(', ') : 'None'}\n`;
            if (notes) {
                message += `*Notes:* ${notes}\n`;
            }
            message += `\n*Total Amount:* ${total}`;

            const whatsappNumber = '233537440435';
            const whatsappUrl = `https://api.whatsapp.com/send?phone=${whatsappNumber}&text=${encodeURIComponent(message)}`;

            window.open(whatsappUrl, '_blank');
        }
    </script>
</body>
</html>